# Copy to .env and fill in. Never commit .env.

# Claude API (Phase 3)
ANTHROPIC_API_KEY=
INTELBRIEF_MODEL=claude-sonnet-5-5

# NVD API key (Phase 2, optional but raises rate limits)
NVD_API_KEY=

# Paths (defaults shown)
INTELBRIEF_DB_PATH=data/intelbrief.db
INTELBRIEF_CACHE_DIR=data/cache

# HTTP timeout for feed downloads, in seconds
INTELBRIEF_HTTP_TIMEOUT=30
